# PandoraBox ZTP bootstrap - runs inside the IOS-XE Guest Shell (python2 on 16.x, python3 on 17.x)
import json
import re

import cli

try:
    from urllib.request import Request, urlopen
except ImportError:
    from urllib2 import Request, urlopen

SERVER = "http://{{ server_ip }}:{{ http_port }}"


def post(path, data):
    req = Request(SERVER + path, json.dumps(data).encode("utf-8"), {"Content-Type": "application/json"})
    urlopen(req, timeout=30).read()


inv = cli.execute("show inventory")
m = re.search(r"SN:\s*(\S+)", inv)
serial = m.group(1) if m else ""
version = cli.execute("show version")

resp = urlopen(SERVER + "/ztp/cfg?serial=" + serial, timeout=30)
if resp.getcode() != 200:
    post("/ztp/done", {"serial": serial, "ok": False, "error": "not queued", "version": version})
else:
    lines = [l for l in resp.read().decode("utf-8").splitlines() if l.strip() and not l.lstrip().startswith("!")]
    try:
        cli.configurep(lines)
        cli.executep("write memory")
        post("/ztp/done", {"serial": serial, "ok": True, "version": version})
    except Exception as e:  # report and let the operator retry
        post("/ztp/done", {"serial": serial, "ok": False, "error": str(e), "version": version})

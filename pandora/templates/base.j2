! ===== PandoraBox base (mgmt access) - {{ hostname }} =====
hostname {{ hostname }}
ip domain name {{ domain }}
no ip domain lookup
service password-encryption
username {{ admin_user }} privilege 15 secret {{ admin_password }}
{% if role != 'router_edge' and staged %}
{# stage 1 of a two-stage AutoInstall (model unknown, so port names unknown): no port named at all. Every port of a
   factory switch is in VLAN 1, so the PC reaches this address on whichever port it is cabled to. Stage 2
   (Ctx.stage_two, over SSH) asks the box its ports and the PC's port, then moves management to VLAN {{ mgmt_vlan }}. #}
interface Vlan1
 ip address {{ mgmt_ip }} {{ netmask }}
 no shutdown
{% if gateway %}
ip default-gateway {{ gateway }}
{% endif %}
{% elif role != 'router_edge' %}
vlan {{ mgmt_vlan }}
 name PANDORA-MGMT
{# exit commits the VLAN: a file copied to running-config (PnP, real 2960X 15.2) otherwise reached the access ports
   first and IOS auto-created VLAN 99 named VLAN0099 #}
exit
{% if factory %}
! factory bootstrap ran on Vlan1 in the same subnet: move mgmt to Vlan{{ mgmt_vlan }}
interface Vlan1
 no ip address
 shutdown
{% endif %}
{% for p in reserved_ports %}
interface {{ p }}
 description PANDORA-MGMT reserved
 switchport mode access
 switchport access vlan {{ mgmt_vlan }}
 spanning-tree portfast
 no shutdown
{% endfor %}
{# ops_retired: the management design gave it an address in its domain and the old one was removed (mgmt.retire) #}
interface Vlan{{ mgmt_vlan }}
 description PANDORA-MGMT
{% if ops_retired %}
 no ip address
{% else %}
 ip address {{ mgmt_ip }} {{ netmask }}
{% endif %}
 no shutdown
{% if gateway and not ops_retired %}
ip default-gateway {{ gateway }}
{% endif %}
{% else %}
interface {{ reserved_ports[0] }}
 description PANDORA-MGMT reserved
{% if ops_retired %}
 no ip address
{% else %}
 ip address {{ mgmt_ip }} {{ netmask }}
{% endif %}
 no shutdown
{% if gateway and not ops_retired %}
ip route 0.0.0.0 0.0.0.0 {{ gateway }}
{% endif %}
{% endif %}
{% if factory %}
{# only on factory boxes: with existing keys IOS asks "replace them? [yes/no]" and eats the next line #}
crypto key generate rsa general-keys modulus 2048
{% endif %}
ip ssh version 2
line vty 0 {{ cap_vty_last }}
 login local
 transport input ssh
snmp-server group PANDORA v3 {{ snmp_level }}
snmp-server user {{ snmp_user }} PANDORA v3 auth sha {{ snmp_auth }}{% if snmp_level == 'priv' %} priv aes 128 {{ snmp_priv }}{% endif %}

snmp-server enable traps snmp linkdown linkup coldstart
{% if cap_traps_config %}
snmp-server enable traps config
{% endif %}
{# informs: IOS localizes the remote user's keys with PandoraBox's engine ID, so that line must come first #}
snmp-server engineID remote {{ server_ip }} {{ snmp_engine_id|upper }}
snmp-server user {{ snmp_user }} PANDORA remote {{ server_ip }} v3 auth sha {{ snmp_auth }}{% if snmp_level == 'priv' %} priv aes 128 {{ snmp_priv }}{% endif %}

snmp-server host {{ server_ip }} informs version 3 {{ snmp_level }} {{ snmp_user }}
{% if autosave %}
! AutoInstall applies to running-config only: save once, then remove this applet
event manager applet PANDORA-SAVE
 event timer countdown time 60
 action 1.0 cli command "enable"
 action 2.0 cli command "configure terminal"
 action 3.0 cli command "no event manager applet PANDORA-SAVE"
 action 4.0 cli command "end"
 action 5.0 cli command "write memory"
{% endif %}
